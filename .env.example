# Qualitative/supply scoring uses the Claude Code CLI (subscription): `claude --print`
# Install: npm install -g @anthropic-ai/claude-code

# FRED API key (optional — improves GLI filter when set)
# FRED_API_KEY=xxx

# CoinGecko API key (optional — free tier works but has rate limits)
# https://www.coingecko.com/en/api/pricing
# COINGECKO_API_KEY=CG-xxxxx

# Optional CLI tuning (see pipeline/fetchers/qualitative.py)
# CLAUDE_MODEL=opus
# CLAUDE_CLI_TIMEOUT=300
# CLAUDE_ADOPTION_TIMEOUT=300
