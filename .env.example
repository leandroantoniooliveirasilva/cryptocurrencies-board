# OpenCode CLI — qualitative & supply scoring (`opencode run`)
# Install: https://opencode.ai/docs  (e.g. brew install anomalyco/tap/opencode)
# Auth: OpenCode Zen / provider keys per OpenCode docs
#
# OPENCODE_BIN=opencode
# OPENCODE_MODEL=opencode/big-pickle
# OPENCODE_RUN_TIMEOUT=300
# OPENCODE_ADOPTION_TIMEOUT=300
# OPENCODE_SUPPLY_TIMEOUT=60

# FRED API key (optional — improves GLI filter when set)
# FRED_API_KEY=xxx

# CoinGecko API key (optional — free tier works but has rate limits)
# COINGECKO_API_KEY=CG-xxxxx
