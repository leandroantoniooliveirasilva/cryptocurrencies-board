# LLM agent CLI — qualitative, supply, and discovery scoring.
# Default: Claude Code (`claude --print`). Install and auth:
#   claude login   # or set ANTHROPIC_API_KEY
# Switch to Cursor Agent (`cursor-agent --print`) with LLM_AGENT_CLI=cursor.
#
# LLM_AGENT_CLI=claude            # claude (default) | cursor
#
# Claude Code overrides:
# CLAUDE_AGENT_BIN=claude
# CLAUDE_AGENT_MODEL=sonnet       # sonnet | opus | haiku | full model id
#
# Cursor Agent overrides (only used when LLM_AGENT_CLI=cursor):
# CURSOR_AGENT_BIN=cursor-agent
# CURSOR_AGENT_MODEL=auto
#
# Per-invocation timeouts (seconds). Generic names below take precedence;
# the legacy CURSOR_AGENT_*_TIMEOUT names are still honored as a fallback.
# LLM_AGENT_RUN_TIMEOUT=300
# LLM_AGENT_ADOPTION_TIMEOUT=300
# LLM_AGENT_SUPPLY_TIMEOUT=60

# Per-asset scoring subprocess wall clock (parent waits on each child). Default 7200.
# Set to 0 to disable the per-child cap (or raise if LLM calls exceed this).
# PIPELINE_SCORE_ASSET_TIMEOUT=7200

# FRED API key (optional — improves GLI filter when set)
# FRED_API_KEY=xxx

# CoinGecko API key (optional — free tier works but has rate limits)
# COINGECKO_API_KEY=CG-xxxxx
